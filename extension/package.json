{
  "name": "tithon",
  "displayName": "Tithon",
  "version": "0.2.6",
  "private": true,
  "publisher": "rnoro",
  "license": "MIT",
  "icon": "icon.png",
  "categories": [
    "Notebooks",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "jupyter",
    "notebook",
    "kernel",
    "remote",
    "persistent",
    "ipywidgets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rnoro/tithon.git"
  },
  "bugs": {
    "url": "https://github.com/rnoro/tithon/issues"
  },
  "homepage": "https://github.com/rnoro/tithon#readme",
  "description": "Tithon VSCode extension - Persistent Jupyter kernel execution and live output streaming in VSCode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "type": "commonjs",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onNotebook:tithon-py",
    "onCommand:tithon.runCell",
    "onNotebook:tithon-notebook"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tithon-notebook",
        "aliases": [
          "Python Notebook"
        ],
        "extensions": [
          ".pynb"
        ],
        "icon": {
          "light": "./icons/pynb.svg",
          "dark": "./icons/pynb.svg"
        }
      }
    ],
    "notebooks": [
      {
        "type": "tithon-notebook",
        "displayName": "Python Notebook",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.pynb"
          }
        ]
      },
      {
        "type": "tithon-py",
        "displayName": "Notebook",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.py"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "tithon-widget",
        "displayName": "Tithon ipywidget renderer",
        "entrypoint": "./dist/widgetRenderer.js",
        "requiresMessaging": "optional",
        "mimeTypes": [
          "application/vnd.tithon.widget+json"
        ]
      }
    ],
    "commands": [
      {
        "command": "tithon.restartKernel",
        "title": "Restart Kernel",
        "category": "Tithon",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tithon.interruptKernel",
        "title": "Interrupt Kernel",
        "category": "Tithon",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tithon.openAsNotebook",
        "title": "Open as Notebook",
        "category": "Tithon",
        "icon": "$(notebook)"
      },
      {
        "command": "tithon.openAsText",
        "title": "Open as Text Editor",
        "category": "Tithon",
        "icon": "$(file-code)"
      },
      {
        "command": "tithon.alwaysOpenAsNotebook",
        "title": "Always Open This File as a Notebook",
        "category": "Tithon",
        "icon": "$(pin)"
      },
      {
        "command": "tithon.forgetAlwaysOpenAsNotebook",
        "title": "Stop Always Opening This File as a Notebook",
        "category": "Tithon",
        "icon": "$(pinned)"
      },
      {
        "command": "tithon.alwaysOpenWith",
        "title": "Always Open With…",
        "category": "Tithon",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tithon.selectInterpreter",
        "title": "Select Python Interpreter",
        "category": "Tithon",
        "icon": "$(snake)"
      },
      {
        "command": "tithon.restartDaemon",
        "title": "Restart Daemon",
        "category": "Tithon"
      },
      {
        "command": "tithon.killKernel",
        "title": "Terminate Kernel…",
        "category": "Tithon",
        "icon": "$(trash)"
      },
      {
        "command": "tithon.restoreOutputs",
        "title": "Restore Previous Outputs",
        "category": "Tithon",
        "icon": "$(history)"
      },
      {
        "command": "tithon.importNotebook",
        "title": "Import Jupyter Notebook…",
        "category": "Tithon"
      },
      {
        "command": "tithon.exportNotebook",
        "title": "Export to Jupyter Notebook…",
        "category": "Tithon"
      },
      {
        "command": "tithon.showStorage",
        "title": "Show Session Storage",
        "category": "Tithon"
      },
      {
        "command": "tithon.retryRestore",
        "title": "Retry Output Restore",
        "category": "Tithon"
      },
      {
        "command": "tithon.newNotebook",
        "title": "New Python Notebook…",
        "category": "Tithon"
      },
      {
        "command": "tithon.copyAsNotebook",
        "title": "Copy as Python Notebook…",
        "category": "Tithon"
      },
      {
        "command": "tithon.exportPythonScript",
        "title": "Export Python Script…",
        "category": "Tithon"
      }
    ],
    "configuration": {
      "title": "Tithon",
      "properties": {
        "tithon.homePath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Daemon home directory on the extension host. Use an absolute path or ~/. Empty uses TITHON_HOME, then ~/.tithon. Applies to this window after Reload Window; previous journals and kernels are kept. Show Session Storage displays the active directory."
        },
        "tithon.reconnectMaxAttempts": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "scope": "window",
          "description": "Maximum automatic reconnect attempts per notebook after a failed connection or disconnect. The first automatic retry counts as attempt 1; the initial connection does not count. 0 retries indefinitely. Success or manual Retry resets the count. Cancel in the reconnect notification stops retries without stopping the daemon or kernel."
        },
        "tithon.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the Tithon daemon on the host when it isn't already running (spawned detached, so it survives reconnects)."
        },
        "tithon.daemonCommand": {
          "type": "string",
          "default": "tithon",
          "description": "Command used to launch the daemon (run as `<command> daemon`). Set to an absolute path if `tithon` is not on PATH."
        },
        "tithon.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to run the daemon as `<python> -m tithon daemon` (works without activating the venv). Leave empty to use the interpreter selected by the Python extension."
        },
        "tithon.confirmDestructiveActions": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation in a modal dialog before an action that destroys running kernel state (Restart Kernel, Terminate Kernel, Restart Daemon). Turn off only if you restart often and accept losing the namespace on a mis-click."
        },
        "tithon.kernelIdleTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Reap a kernel after this many seconds idle (no attached notebook, nothing running or queued). Outputs stay restorable from the journal; only the in-memory variables are lost. 0 = never (default). Applied when the extension (re)starts the daemon."
        },
        "tithon.historyRetentionDays": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Remove output events older than this many days after safely saving current outputs. 0 disables age retention. Applied when the daemon is started; restart required for changes."
        },
        "tithon.historyTargetMiB": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Logical storage target in MiB. Current outputs and widget/kernel records are preserved, so this is not a hard limit. 0 disables size retention. Applied when the daemon is started; restart required for changes."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "tithon.openAsNotebook",
          "when": "resourceExtname == .py && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "tithon.openAsText",
          "when": "notebookType == tithon-py",
          "group": "navigation"
        },
        {
          "command": "tithon.alwaysOpenWith",
          "when": "resourceScheme == file && resourceExtname == .py",
          "group": "1_tithon@1"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "tithon.alwaysOpenWith",
          "when": "notebookType == tithon-py",
          "group": "tithon@1"
        },
        {
          "command": "tithon.restartKernel",
          "when": "notebookType == tithon-py || notebookType == tithon-notebook",
          "group": "navigation/execute@2"
        },
        {
          "command": "tithon.selectInterpreter",
          "when": "notebookType == tithon-py || notebookType == tithon-notebook",
          "group": "navigation/view@1"
        },
        {
          "command": "tithon.killKernel",
          "when": "notebookType == tithon-py || notebookType == tithon-notebook",
          "group": "kernel@1"
        },
        {
          "command": "tithon.copyAsNotebook",
          "when": "notebookType == tithon-py",
          "group": "tithon@2"
        },
        {
          "command": "tithon.exportPythonScript",
          "when": "notebookType == tithon-notebook",
          "group": "tithon@2"
        }
      ],
      "explorer/context": [
        {
          "command": "tithon.alwaysOpenWith",
          "when": "resourceScheme == file && resourceExtname == .py",
          "group": "open@10"
        },
        {
          "command": "tithon.copyAsNotebook",
          "when": "resourceScheme == file && resourceExtname == .py",
          "group": "tithon@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tithon.killKernel"
        },
        {
          "command": "tithon.alwaysOpenAsNotebook",
          "when": "false"
        },
        {
          "command": "tithon.forgetAlwaysOpenAsNotebook",
          "when": "false"
        },
        {
          "command": "tithon.alwaysOpenWith",
          "when": "resourceScheme == file && resourceExtname == .py"
        },
        {
          "command": "tithon.openAsText",
          "when": "notebookType == tithon-py"
        },
        {
          "command": "tithon.openAsNotebook",
          "when": "resourceExtname == .py"
        },
        {
          "command": "tithon.copyAsNotebook",
          "when": "resourceExtname == .py"
        },
        {
          "command": "tithon.exportPythonScript",
          "when": "resourceExtname == .pynb"
        }
      ]
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:serializer": "vitest run test/serializer.test.ts test/cellAttach.test.ts",
    "test:widget": "vitest run test/widget.test.ts",
    "build": "tsc -p ./",
    "bundle": "node esbuild.mjs",
    "vscode:prepublish": "node esbuild.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/semver": "7.8.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^3.0.0",
    "fast-check": "^3.15.0",
    "glob": "^13.0.6",
    "jsdom": "^24.0.0",
    "mocha": "^11.7.6",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.11",
    "@jupyter-widgets/controls": "^5.0.12",
    "@jupyter-widgets/html-manager": "^1.0.14",
    "anywidget": "0.11.0",
    "semver": "7.8.4",
    "ws": "^8.21.0"
  }
}
