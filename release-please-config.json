{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(${branch}): release",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "pull-request-header": "🚀 New version unlocked. Check out what's inside!",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "tithon",
      "component": "tithon",
      "include-component-in-tag": false,
      "exclude-paths": ["extension", "docs", "scripts"],
      "release-as": "0.3.0"
    },
    "extension": {
      "release-type": "node",
      "package-name": "tithon-extension",
      "component": "vscode",
      "release-as": "0.3.0"
    }
  }
}
